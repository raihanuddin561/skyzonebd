# ==============================================================================
# SKYZONEBD ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Usage on Ubuntu VPS:
# Copy this file to /var/www/skyzonebd/app/.env.production and populate real values.
# NEVER commit .env.production to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Set to 'production' on Ubuntu VPS
NODE_ENV="production"

# Application Port (Port 3001 is dedicated to SkyzoneBD; Port 3000 is reserved for Kuttush)
PORT="3001"

# Public domain and API URLs (Must match your production domain https://skyzonebd.shop)
NEXT_PUBLIC_SITE_URL="https://skyzonebd.shop"
NEXT_PUBLIC_API_URL="https://skyzonebd.shop"
NEXT_PUBLIC_API_BASE_URL="https://skyzonebd.shop"
NEXT_PUBLIC_USE_API="true"

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Neon connection string. In production, always append ?sslmode=require
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (PRIVATE - KEEP SECRET!)
# ------------------------------------------------------------------------------
# Strong random 64-character hex string for signing JWT tokens.
# Generate on Linux terminal via: openssl rand -hex 32
JWT_SECRET="generate_with_openssl_rand_hex_32"

# Secret key required to access /api/migrate endpoint (Bearer token)
# Generate on Linux terminal via: openssl rand -hex 24
MIGRATION_SECRET_KEY="generate_with_openssl_rand_hex_24"

# Secret key required to access /api/seed endpoint
# Generate on Linux terminal via: openssl rand -hex 24
SEED_SECRET="generate_with_openssl_rand_hex_24"

# Set to 'true' only if you explicitly need to bypass database reset/seed guards in production
# (Default: false / unset for data loss prevention)
ALLOW_PRODUCTION_DB_RESET="false"
ALLOW_PRODUCTION_SEED="false"

# ------------------------------------------------------------------------------
# 4. VERCEL BLOB STORAGE (IMAGE & CATALOG STORAGE)
# ------------------------------------------------------------------------------
# Obtain from Vercel Dashboard > Storage > Blob Store > Settings
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# Alternative token name (supported as fallback by upload handlers)
SKY_ZONE_BD_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (RESEND)
# ------------------------------------------------------------------------------
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_sample_api_key_here"

# Notification recipient for low-stock and operational alerts
ADMIN_ALERT_EMAIL="admin@skyzonebd.shop"

# ------------------------------------------------------------------------------
# 6. BUSINESS & PRICING RULES (DEFAULTS)
# ------------------------------------------------------------------------------
# Default VAT percentage (0-100). Can also be configured dynamically in admin settings.
TAX_RATE="0"

# Default shipping charge in BDT. Configured dynamically per delivery zone in admin settings.
SHIPPING_CHARGE="0"
