# Database
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_token_here"
# Alternative env var name (Vercel auto-generates this)
SKY_ZONE_BD_BLOB_READ_WRITE_TOKEN="vercel_blob_token_here"

# JWT Secret (Generate a strong random string)
JWT_SECRET="your-secret-key-here"

# Migration Secret (for /api/migrate endpoint)
MIGRATION_SECRET_KEY="your-migration-secret-key-here"

# Seed Secret (for /api/seed endpoint - prevents unauthorized seeding)
SEED_SECRET="your-seed-secret-key-here"

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Email Service (Resend - recommended)
# Get your API key from: https://resend.com
RESEND_API_KEY="re_your_api_key_here"

# Optional: Use API vs Mock Data
NEXT_PUBLIC_USE_API="true"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Order pricing constants (both silently default to 0 if unset — see
# docs/engineering-workflow/06_Coding_Standards.md §12 and
# docs/architecture-review/14_Technical_Debt.md for why that's flagged as a
# risk, not a feature; set these explicitly rather than relying on the default)
TAX_RATE="0"
SHIPPING_CHARGE="0"

# Optional: where to send proactive low-stock alert emails (Amazon-style
# gap-closure Phase 1). If unset, no alert is sent — not an error, just no
# configured recipient.
ADMIN_ALERT_EMAIL="ops@yourdomain.com"

# Production Settings (Update for deployment)
# DATABASE_URL="postgresql://user:password@production-host:5432/production-db?schema=public"
# NEXT_PUBLIC_API_URL="https://yourdomain.com"
# NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
# NODE_ENV="production"

